{
  "realm": "eka",
  "enabled": true,
  "displayName": "Enterprise Knowledge Assistant (local development)",
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      { "name": "eka.admin", "description": "Tenant administrator: may manage any document in their tenant (ADR-0031). Grants no read access." }
    ]
  },
  "groups": [
    { "name": "hr" },
    { "name": "finance" }
  ],
  "clientScopes": [
    {
      "name": "eka.access",
      "description": "Access to the Enterprise Knowledge Assistant API. Carries every claim the API reads.",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "audience eka-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "eka-api", "access.token.claim": "true", "id.token.claim": "false" }
        },
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": { "access.token.claim": "true", "introspection.token.claim": "true" }
        },
        {
          "name": "tenant id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": { "user.attribute": "tid", "claim.name": "tid", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "true", "userinfo.token.claim": "true" }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": { "full.path": "false", "claim.name": "groups", "access.token.claim": "true", "id.token.claim": "true", "userinfo.token.claim": "true" }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": { "claim.name": "roles", "multivalued": "true", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "false" }
        },
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": { "user.attribute": "email", "claim.name": "email", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "true" }
        },
        {
          "name": "name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "config": { "access.token.claim": "true", "id.token.claim": "true" }
        },
        {
          "name": "preferred_username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": { "user.attribute": "username", "claim.name": "preferred_username", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "true" }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "eka-cli",
      "name": "EKA local development and the Step 13 web client",
      "description": "Public client. The password grant is enabled for LOCAL DEVELOPMENT ONLY (scripts and curl); a deployed realm must disable it and use the authorization code flow with PKCE.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [ "http://localhost:4200/*" ],
      "webOrigins": [ "http://localhost:4200" ],
      "attributes": { "pkce.code.challenge.method": "S256", "post.logout.redirect.uris": "http://localhost:4200/*" },
      "defaultClientScopes": [ "eka.access" ],
      "optionalClientScopes": []
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"tid\",\"displayName\":\"Tenant id\",\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"multivalued\":false}]}"
          ]
        }
      }
    ]
  },
  "users": [
    {
      "username": "alice", "enabled": true, "email": "alice@tenant-a.example", "emailVerified": true, "firstName": "Alice", "lastName": "Example",
      "attributes": { "tid": [ "11111111-1111-1111-1111-111111111111" ] },
      "credentials": [ { "type": "password", "value": "local-dev-only", "temporary": false } ]
    },
    {
      "username": "carol", "enabled": true, "email": "carol@tenant-a.example", "emailVerified": true, "firstName": "Carol", "lastName": "Example",
      "attributes": { "tid": [ "11111111-1111-1111-1111-111111111111" ] },
      "groups": [ "/hr" ],
      "credentials": [ { "type": "password", "value": "local-dev-only", "temporary": false } ]
    },
    {
      "username": "dana", "enabled": true, "email": "dana@tenant-a.example", "emailVerified": true, "firstName": "Dana", "lastName": "Example",
      "attributes": { "tid": [ "11111111-1111-1111-1111-111111111111" ] },
      "groups": [ "/finance" ],
      "credentials": [ { "type": "password", "value": "local-dev-only", "temporary": false } ]
    },
    {
      "username": "root", "enabled": true, "email": "root@tenant-a.example", "emailVerified": true, "firstName": "Root", "lastName": "Administrator",
      "attributes": { "tid": [ "11111111-1111-1111-1111-111111111111" ] },
      "realmRoles": [ "eka.admin" ],
      "credentials": [ { "type": "password", "value": "local-dev-only", "temporary": false } ]
    },
    {
      "username": "bruno", "enabled": true, "email": "bruno@tenant-b.example", "emailVerified": true, "firstName": "Bruno", "lastName": "Example",
      "attributes": { "tid": [ "22222222-2222-2222-2222-222222222222" ] },
      "credentials": [ { "type": "password", "value": "local-dev-only", "temporary": false } ]
    }
  ]
}
