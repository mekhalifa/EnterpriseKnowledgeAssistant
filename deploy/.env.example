# Copy to deploy/.env and set a real password. deploy/.env is gitignored.
#
#   cp .env.example .env
#
# SQL Server rejects weak passwords at startup with a message that looks like a general
# failure, so: at least 8 characters, and at least three of uppercase, lowercase, digit,
# and symbol.
#
# This is a LOCAL DEVELOPMENT credential only. Production uses a managed identity or a
# secret from a vault, never a password in a file.
MSSQL_SA_PASSWORD=ChangeMe_Local_Dev_1
