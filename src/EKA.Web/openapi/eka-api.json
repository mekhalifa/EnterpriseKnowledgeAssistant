              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/conversations/{conversationId}/messages/stream": {
      "post": {
        "tags": [
          "Conversations"
        ],
        "summary": "Asks a question and streams the answer as server-sent events: \u0027delta\u0027 events while the model writes, then one \u0027completed\u0027 (the persisted exchange) or \u0027error\u0027 (a problem document; nothing persisted).",
        "operationId": "AskQuestionStreaming",
        "parameters": [
          {
            "name": "conversationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
