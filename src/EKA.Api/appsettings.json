{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Ingestion": {
    "MaxUploadBytes": 26214400,
    "StalledAfter": "00:05:00",
    "SweepBatchSize": 100
  },

  "VectorStore": {
    "Endpoint": "http://127.0.0.1:6334",
    "CollectionName": "eka_chunks"
  },

  "Chat": {
    "PromptTemplateName": "default",
    "MaxPromptTokens": 6000,
    "MaxHistoryMessages": 20
  },

  "//Ai": [
    "Everything here is safe to commit. Ai:ApiKey is NOT here and must never be: set it with",
    "  dotnet user-secrets --project src/EKA.Api set \"Ai:ApiKey\" \"<key>\"",
    "or the Ai__ApiKey environment variable. The app refuses to start without it.",
    "EmbeddingDimensions fixes the vector collection shape (Step 8); changing it means",
    "re-indexing every document. ChatModel is free to change at any time. See ADR-0015."
  ],
  "Ai": {
    "Kind": "OpenAICompatible",
    "Endpoint": "https://openrouter.ai/api/v1",
    "ChatModel": "openai/gpt-4o-mini",
    "EmbeddingModel": "openai/text-embedding-3-small",
    "EmbeddingDimensions": 1536,
    "Temperature": 0,
    "MaxOutputTokens": 1000,
    "Resilience": {
      "AttemptTimeout": "00:01:00",
      "TotalTimeout": "00:03:00",
      "MaxRetryAttempts": 3,
      "RetryBaseDelay": "00:00:02",
      "CircuitBreakDuration": "00:00:30"
    }
  }
}
