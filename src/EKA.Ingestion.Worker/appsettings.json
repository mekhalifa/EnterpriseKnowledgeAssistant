{
  "Logging": {
    "//Console": "JSON lines on stdout outside Development: one event per line, scopes (trace and span id) included, for whatever collects container logs. Development overrides with the readable format (Step 14, ADR-0035).",
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ"
      }
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Hangfire": "Warning"
    }
  },

  "Ingestion": {
    "MaxUploadBytes": 26214400,
    "StalledAfter": "00:05:00",
    "SweepBatchSize": 100,
    "WorkerCount": 2
  },

  "Indexing": {
    "ChunkTargetTokens": 500,
    "ChunkOverlapTokens": 75,
    "EmbeddingBatchSize": 64,
    "MaxConcurrentBatches": 2
  },

  "VectorStore": {
    "Endpoint": "http://127.0.0.1:6334",
    "CollectionName": "eka_chunks"
  },

  "Ai": {
    "Kind": "OpenAICompatible",
    "Endpoint": "https://openrouter.ai/api/v1",
    "ChatModel": "openai/gpt-4o-mini",
    "EmbeddingModel": "openai/text-embedding-3-small",
    "EmbeddingDimensions": 1536,
    "Resilience": {
      "AttemptTimeout": "00:01:00",
      "TotalTimeout": "00:03:00",
      "MaxRetryAttempts": 3,
      "RetryBaseDelay": "00:00:02",
      "CircuitBreakDuration": "00:00:30"
    }
  }
}
