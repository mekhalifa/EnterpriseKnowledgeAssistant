<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!-- The readiness probe runs a real query, and the only layer that knows how is this
         one. EKA.Api asks for "is the app ready", not "can you reach SQL Server". -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- Ingestion adapters (Step 7). EKA.Application's boundary tests forbid every one of these. -->
    <PackageReference Include="Hangfire.Core" />
    <PackageReference Include="Hangfire.SqlServer" />
    <PackageReference Include="Hangfire.NetCore" />
    <PackageReference Include="PdfPig" />
    <PackageReference Include="DocumentFormat.OpenXml" />
    <!-- Vector store adapter (Step 8). Also forbidden in EKA.Application. -->
    <PackageReference Include="Qdrant.Client" />
    <!-- Telemetry shared by both hosts (Step 14, ADR-0035). Also forbidden in EKA.Application. -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="OpenTelemetry.Instrumentation.SqlClient" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EKA.Application\EKA.Application.csproj" />
    <ProjectReference Include="..\EKA.Domain\EKA.Domain.csproj" />
  </ItemGroup>

</Project>
