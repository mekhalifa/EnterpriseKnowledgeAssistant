<Project>

  <!--
    Central Package Management (CPM).

    Every NuGet version in this repository is declared HERE, exactly once.
    Projects reference packages WITHOUT a version attribute:

        <PackageReference Include="xunit" />

    Why: across eleven projects, per-project versions drift. EKA.Api ends up on
    Serilog 4.1 while EKA.Infrastructure is on 4.3, and the symptom is a confusing
    binding error that costs hours to trace. With CPM an upgrade is a one-line diff.

    TWO THINGS LEARNED THE HARD WAY (see docs/steps/step-03-persistence.md):

    1. `dotnet add package` resolves the LATEST version, which is 11.0.x for the
       Microsoft families — and 11.0.x targets net11.0 only, so it fails NU1202
       against our net10.0. Add new Microsoft packages with an explicit version
       flag pinning 10.0.x, or edit this file by hand.

    2. `dotnet add package` also appends to whichever ItemGroup it finds first
       (regardless of label) and strips blank lines. Move the entry afterwards.

    3. An XML comment may not contain two consecutive hyphens. Writing a CLI
       flag such as the long form of "version" inside a comment here makes this
       file unloadable, and MSBuild then reports NU1015 ("no version specified")
       on every project rather than a parse error — a thoroughly misleading
       symptom for a one-character mistake.

    See docs/adr/0005-central-package-management.md
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!--
      Transitive pinning: a PackageVersion below also overrides the version of that package
      when it arrives INDIRECTLY. Needed since Step 7: Hangfire.Core asks for Newtonsoft.Json
      >= 11.0.1, NuGet resolves the lowest version satisfying a range, and 11.0.1 carries
      GHSA-5crp-9r3c-p9vr (high severity). NuGet audit + TreatWarningsAsErrors failed the
      build on it (NU1903), which is that setting earning its keep.
    -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <!--
      One version line for the whole Microsoft 10.x family. Mixing 10.0.14 and
      10.0.15 across projects is precisely the drift CPM exists to prevent, so the
      version lives in this property and every Microsoft package below references it.
    -->
    <MicrosoftRuntimeVersion>10.0.15</MicrosoftRuntimeVersion>
    <!--
      The dotnet/extensions release train (Microsoft.Extensions.AI, Http.Resilience) is
      versioned separately from the runtime: 10.11.x is a net10-compatible release, NOT a
      mismatch with 10.0.15. Its 11.0.0 is the same net11 trap described above.
    -->
    <MicrosoftExtensionsLibrariesVersion>10.11.0</MicrosoftExtensionsLibrariesVersion>
  </PropertyGroup>

  <ItemGroup Label="AI">
    <!--
      Microsoft.Extensions.AI: the provider-neutral IChatClient / IEmbeddingGenerator and
      the middleware builders (logging, later OpenTelemetry). .AI.OpenAI adapts the
      official OpenAI SDK to those interfaces; the SDK itself (package "OpenAI") arrives
      transitively and is pinned here so an upgrade is a deliberate one-line diff.
      Referenced by EKA.AI only. EKA.Application must never see any of them.
    -->
    <PackageVersion Include="Microsoft.Extensions.AI" Version="$(MicrosoftExtensionsLibrariesVersion)" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="$(MicrosoftExtensionsLibrariesVersion)" />
    <PackageVersion Include="OpenAI" Version="2.15.0" />
    <!-- Timeout, retry with jittered backoff, circuit breaker, as an HttpClient handler. -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="$(MicrosoftExtensionsLibrariesVersion)" />
  </ItemGroup>

  <ItemGroup Label="ASP.NET Core">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="$(MicrosoftRuntimeVersion)" />
  </ItemGroup>

  <ItemGroup Label="Validation">
    <!--
      NOT on the Microsoft version line: FluentValidation ships on its own cadence and
      targets netstandard2.0, so 12.x runs on net10.0 without a 12-for-10 mismatch.
      Apache-2.0 and free, unlike FluentAssertions v8+ (see ADR-0007) - the two libraries
      share a naming style and nothing else.
      The DependencyInjectionExtensions package pulls in FluentValidation itself, so the
      core package is not listed separately.
    -->
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
  </ItemGroup>

  <ItemGroup Label="Diagnostics">
    <!-- Readiness probe backed by a real query against the configured database. -->
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="$(MicrosoftRuntimeVersion)" />
  </ItemGroup>

  <ItemGroup Label="Hosting and configuration">
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="$(MicrosoftRuntimeVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="$(MicrosoftRuntimeVersion)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(MicrosoftRuntimeVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="$(MicrosoftRuntimeVersion)" />
    <!-- IOptions<T> / IValidateOptions<T> only: EKA.Application reads ChatOptions without
         knowing where configuration comes from. Binding stays in EKA.Api. -->
    <PackageVersion Include="Microsoft.Extensions.Options" Version="$(MicrosoftRuntimeVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="$(MicrosoftRuntimeVersion)" />
    <!-- Test-side: the provider smoke test reads the key the same way EKA.Api does. -->
    <PackageVersion Include="Microsoft.Extensions.Configuration.UserSecrets" Version="$(MicrosoftRuntimeVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="$(MicrosoftRuntimeVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="$(MicrosoftRuntimeVersion)" />
  </ItemGroup>

  <ItemGroup Label="Ingestion">
    <!--
      Hangfire: durable background jobs stored in the same SQL Server (ADR-0020). The API
      only enqueues (Hangfire.SqlServer + Core); the worker runs the server (Hangfire.NetCore).
      Hangfire.SqlServer is given a Microsoft.Data.SqlClient connection factory, so the
      deprecated System.Data.SqlClient never enters the dependency graph.
      LGPL-3.0, used unmodified as a library, which the licence permits in closed products.
    -->
    <PackageVersion Include="Hangfire.Core" Version="1.8.25" />
    <PackageVersion Include="Hangfire.SqlServer" Version="1.8.25" />
    <PackageVersion Include="Hangfire.NetCore" Version="1.8.25" />
    <!-- Transitive only (via Hangfire.Core). Pinned to stay off the vulnerable 11.x floor. -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- Text extraction, pure .NET (ADR-0022). PdfPig: Apache-2.0. Open XML SDK: MIT. -->
    <PackageVersion Include="PdfPig" Version="0.1.16" />
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>

  <ItemGroup Label="Vector store">
    <!-- Qdrant's official gRPC client (ADR-0025), Apache-2.0. Kept on the same minor as the
         server image in deploy/docker-compose.yml and the test fixture: the client speaks the
         server's protobuf API, and Qdrant supports a client one minor away at most. -->
    <PackageVersion Include="Qdrant.Client" Version="1.20.0" />
  </ItemGroup>

  <ItemGroup Label="Persistence">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="$(MicrosoftRuntimeVersion)" />
    <!-- Design is tooling only: PrivateAssets="all" keeps it out of published output. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="$(MicrosoftRuntimeVersion)" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <!-- Shouldly, not FluentAssertions: v8+ of the latter needs a paid commercial
         licence. See docs/adr/0007-assertion-library.md -->
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <!-- Real SQL Server in a throwaway container per test run, rather than a
         sqlite/in-memory stand-in that would not catch the index and constraint
         behaviour this step depends on. -->
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.Qdrant" Version="4.16.0" />
    <!-- WebApplicationFactory: boots the real Program.cs in-process, so endpoint tests
         exercise the actual middleware pipeline rather than a hand-assembled imitation. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="$(MicrosoftRuntimeVersion)" />
    <!--
      Microsoft.Extensions.TimeProvider.Testing is deliberately NOT referenced. TimeProvider
      is an abstract class with two virtual members, so a fixed-clock test double is ten
      lines (tests/EKA.Application.Tests/Fakes/FixedTimeProvider.cs). A package on a
      different version line than the rest of the Microsoft family, for ten lines, is a
      standing upgrade hazard in exchange for nothing.
    -->
  </ItemGroup>

  <!--
    Added as the roadmap reaches them, so the dependency surface stays honest:
      Step 4  FluentValidation.DependencyInjectionExtensions
      Step 5  Microsoft.Extensions.AI, .AI.OpenAI, OpenAI,
              Microsoft.Extensions.Http.Resilience
              (Azure.AI.OpenAI deliberately not yet: see ADR-0015)
      Step 8  Qdrant.Client
      Step 14 Serilog.AspNetCore, OpenTelemetry.Extensions.Hosting
  -->

</Project>
