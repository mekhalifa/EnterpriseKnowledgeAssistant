# EditorConfig for the Enterprise Knowledge Assistant
# https://editorconfig.org
#
# ─────────────────────────────────────────────────────────────────────────────────────
# WHAT THIS FILE DOES AND DOES NOT DO — read this before wondering why a rule "isn't
# working".
#
# `EnforceCodeStyleInBuild` is NOT enabled in Directory.Build.props, so the IDExxxx style
# rules below do not run during `dotnet build`. They drive the IDE's suggestions and
# `dotnet format`. The build gate stays on COMPILER warnings, which are errors here
# (TreatWarningsAsErrors).
#
# That is a deliberate choice, not an oversight. With warnings-as-errors, turning on style
# enforcement in the build means any rule set to `warning` fails the build — including on
# generated code, migrations, and the day a new analyzer version tightens a heuristic. A
# formatting disagreement should not stop a developer from running a test.
#
# The gate arrives in Step 14 as a CI step that cannot block local work:
#     dotnet format --verify-no-changes
#
# The exception is the `dotnet_diagnostic.*` entries at the bottom: analyzer severities DO
# apply whenever the analyzer runs, which is how the two deliberately-ignored Roslynator
# rules are silenced here rather than argued about in every file.
# ─────────────────────────────────────────────────────────────────────────────────────

root = true

[*]
charset = utf-8
end_of_line = crlf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
# 90 is not enforced; it documents the width the existing code is wrapped to, so that a
# reviewer reading a diff side by side does not have to scroll horizontally.
max_line_length = 90

[*.{json,yml,yaml,csproj,props,targets,xml,slnx}]
indent_size = 2

[*.md]
# Two trailing spaces is a Markdown line break. Stripping it silently joins two lines.
trim_trailing_whitespace = false

[*.{cmd,bat}]
end_of_line = crlf

[*.sh]
end_of_line = lf

# ─────────────────────────────────────────────────────────────────────────────────────
# C#
# ─────────────────────────────────────────────────────────────────────────────────────

[*.cs]

# ── Usings ──────────────────────────────────────────────────────────────────────────
# System first, then alphabetical, no blank-line groups. One ordering, consistently, so a
# merge conflict in a using block is a real conflict rather than two tools disagreeing.
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:warning
dotnet_diagnostic.IDE0005.severity = warning   # unnecessary using

# ── File and namespace layout ───────────────────────────────────────────────────────
# File-scoped namespaces: one less level of indentation across the whole codebase, which
# matters when the convention is a 90-column line.
csharp_style_namespace_declarations = file_scoped:warning

# ── this. ───────────────────────────────────────────────────────────────────────────
# Never qualified. Primary constructors make `this.` ambiguous about what it even refers
# to, and the codebase uses them widely.
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning

# ── Types ───────────────────────────────────────────────────────────────────────────
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_predefined_type_for_member_access = true:warning

# `var` only where the type is already on the line. `var document = ...` from a method
# call hides what it is, and these files are read far more often than written.
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# ── Modifiers ───────────────────────────────────────────────────────────────────────
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
csharp_preferred_modifier_order = public,private,protected,internal,file,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,required,volatile,async:warning
dotnet_style_readonly_field = true:warning

# ── Expression-level preferences ────────────────────────────────────────────────────
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_style_prefer_collection_expression = when_types_loosely_match:suggestion
dotnet_style_coalesce_expression = true:warning
dotnet_style_null_propagation = true:warning
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:warning
dotnet_style_prefer_conditional_expression_over_assignment = true:silent
dotnet_style_prefer_conditional_expression_over_return = true:silent
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_prefer_not_pattern = true:warning
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_throw_expression = true:suggestion
csharp_prefer_simple_using_statement = true:suggestion
csharp_style_prefer_primary_constructors = true:suggestion

# ── Braces ──────────────────────────────────────────────────────────────────────────
# Always, even for a one-line if. The goto fail bug was one missing pair of braces, and
# the cost of the rule is one line.
csharp_prefer_braces = true:warning

# ── Unused code ─────────────────────────────────────────────────────────────────────
dotnet_code_quality_unused_parameters = non_public:suggestion
csharp_style_unused_value_assignment_preference = discard_variable:warning
csharp_style_unused_value_expression_statement_preference = discard_variable:silent

# ── New-line and spacing (Allman, the .NET default) ─────────────────────────────────
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_between_query_expression_clauses = true
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_indent_labels = one_less_than_current
csharp_space_after_cast = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_around_binary_operators = before_and_after
csharp_preserve_single_line_statements = false
csharp_preserve_single_line_blocks = true

# ── Naming ──────────────────────────────────────────────────────────────────────────

dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.camel_case.capitalization = camel_case

dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _

dotnet_naming_style.interface_prefix.capitalization = pascal_case
dotnet_naming_style.interface_prefix.required_prefix = I

dotnet_naming_style.type_parameter_prefix.capitalization = pascal_case
dotnet_naming_style.type_parameter_prefix.required_prefix = T

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_rule.interfaces_start_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_start_with_i.style = interface_prefix
dotnet_naming_rule.interfaces_start_with_i.severity = warning

dotnet_naming_symbols.type_parameters.applicable_kinds = type_parameter
dotnet_naming_rule.type_parameters_start_with_t.symbols = type_parameters
dotnet_naming_rule.type_parameters_start_with_t.style = type_parameter_prefix
dotnet_naming_rule.type_parameters_start_with_t.severity = warning

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_rule.private_fields_are_underscore_camel.symbols = private_fields
dotnet_naming_rule.private_fields_are_underscore_camel.style = underscore_camel_case
dotnet_naming_rule.private_fields_are_underscore_camel.severity = warning

dotnet_naming_symbols.public_members.applicable_kinds = class,struct,interface,enum,property,method,event,namespace,delegate
dotnet_naming_symbols.public_members.applicable_accessibilities = public,internal,protected,protected_internal
dotnet_naming_rule.public_members_are_pascal.symbols = public_members
dotnet_naming_rule.public_members_are_pascal.style = pascal_case
dotnet_naming_rule.public_members_are_pascal.severity = warning

dotnet_naming_symbols.parameters_and_locals.applicable_kinds = parameter,local
dotnet_naming_rule.parameters_and_locals_are_camel.symbols = parameters_and_locals
dotnet_naming_rule.parameters_and_locals_are_camel.style = camel_case
dotnet_naming_rule.parameters_and_locals_are_camel.severity = warning

# NOTE: no rule forces constants to SCREAMING_CASE. The .NET convention is PascalCase for
# constants, and `MaxTitleLength` reads the same as any other static member on purpose —
# its constness is not information the caller needs.

# ── Analyzer rules we deliberately do not follow ────────────────────────────────────
#
# Both come from Roslynator, which runs in the IDE here but not in `dotnet build`. They
# are silenced rather than worked around, with the reason recorded, so the suggestion does
# not get re-argued every time somebody opens a domain file.

# RCS1194: "Implement exception constructors." A sealed domain exception exists to be
# thrown one way, with the message its constructor composes. Adding the three standard
# constructors would let callers build a DomainException with no message or an unrelated
# inner exception, which is the opposite of what the type is for. See
# src/EKA.Domain/Common/InvalidStateTransitionException.cs.
dotnet_diagnostic.RCS1194.severity = none

# RCS1170: "Use read-only auto-implemented property." The private setters on domain
# entities are not an oversight — EF Core materializes entities by writing to them. Making
# them get-only moves the problem to backing fields configured by name, which is strictly
# worse: it is the same mutability with none of the visibility. See
# docs/adr/0010-value-object-mapping.md.
dotnet_diagnostic.RCS1170.severity = none

# ── Generated code ──────────────────────────────────────────────────────────────────
# Migrations are generated by `dotnet ef` and rewritten wholesale on every scaffold. Style
# findings on them are noise that can never be fixed for longer than one migration.
[src/EKA.Infrastructure/Persistence/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
